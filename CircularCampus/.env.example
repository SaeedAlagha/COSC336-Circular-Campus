# Circular Campus local configuration. The setup launcher copies this to .env
# (only if .env does not exist) and generates a random secret key.
# NEVER commit .env or share it — it is excluded by .gitignore.

DJANGO_SECRET_KEY=change-me-setup-generates-this
# 0 = production-like local demo (friendly error pages). 1 = developer mode with debug pages.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CAMPUS_TIME_ZONE=Asia/Dubai
CAMPUS_HOLD_HOURS=48
CAMPUS_DEMO_MODE=1
# Password for seeded demo accounts (local demo only, at least 12 characters).
# Leave empty to use the default documented in README.
CAMPUS_DEMO_PASSWORD=

# --- Gemini (optional). Paste your key here privately; never in chat, code or screenshots. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=10
GEMINI_ENABLED=1

# --- PostgreSQL (optional). When POSTGRES_DB is set, PostgreSQL is used instead of SQLite. ---
# POSTGRES_DB=campus
# POSTGRES_USER=campus
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Set to 1 only when served over HTTPS (secure cookies, HSTS, redirect).
CAMPUS_HTTPS=0
