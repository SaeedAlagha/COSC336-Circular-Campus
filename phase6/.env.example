# These variables must be exported by your shell or container; no automatic .env loading.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a strong random value for production.
# DJANGO_SECRET_KEY=
# PostgreSQL is used when POSTGRES_DB is set. Otherwise local SQLite is selected.
# POSTGRES_DB=campus
# POSTGRES_USER=campus
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Optional OpenAI-compatible chat completions endpoint; explicit operator configuration.
# CAMPUS_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# CAMPUS_LLM_MODEL=your-installed-model
# CAMPUS_LLM_KEY=
# CAMPUS_DEMO_PASSWORD=choose-a-local-demo-password
